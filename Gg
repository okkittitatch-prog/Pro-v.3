		AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
		StatusLabel.Text = "สถานะ: กำลังขับรถอัตโนมัติ..."
		startAutoFarm()
	else
		AutoFarmBtn.Text = "🚗 ออโต้ฟาร์ม: ปิด"
		AutoFarmBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		StatusLabel.Text = "สถานะ: หยุดออโต้ฟาร์มแล้ว"
		stopAutoFarm()
	end
end)


