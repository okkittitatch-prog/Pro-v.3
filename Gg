-- 3. สคริปต์ระบบลดกราฟิก (FPS Booster)
-- ==========================================
local function toggleLowGraphics(enable)
	if enable then
		-- ปิด เงา และ หมอก
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e9
		
		-- ลดรายละเอียดวัสดุในฉาก
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("BasePart") and not v:IsA("MeshPart") then
				v.Material = Enum.Material.SmoothPlastic
			elseif v:IsA("Texture") or v:IsA("Decal") then
				v.Transparency = 0.5
			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
				v.Enabled = false
			end
		end
	else
		-- คืนค่าเงาและหมอก
		Lighting.GlobalShadows = originalGlobalShadows
		Lighting.FogEnd = originalFogEnd
	end
end

LowGraphicBtn.MouseButton1Click:Connect(function()
	isLowGraphicsActive = not isLowGraphicsActive
	
	if isLowGraphicsActive then
		LowGraphicBtn.Text = "⚡ ลดกราฟิก (ลื่นขึ้น): เปิด"
		LowGraphicBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
		toggleLowGraphics(true)
	else
		LowGraphicBtn.Text = "⚡ ลดกราฟิก (ลื่นขึ้น): ปิด"
		LowGraphicBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
		toggleLowGraphics(false)
	end
end)
